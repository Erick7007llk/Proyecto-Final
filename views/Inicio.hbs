<!DOCTYPE html>
<html lang="es">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Farmacia GBC — Tu salud, nuestra prioridad</title>
  <meta name="description"
    content="Farmacia GBC: medicamentos, ofertas y atención profesional. Más de 25 años cuidando tu salud con sucursales en toda la ciudad." />
  <link rel="icon" type="image/svg+xml" href="/favicon.ico" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:ital,wght@1,700;1,800&family=Poppins:wght@600;700;800&display=swap"
    rel="stylesheet" />
  <link rel="stylesheet" href="/css/Inicio.css">
  <link rel="stylesheet" href="/css/nosotros.css">
  <link rel="stylesheet" href="/css/contacto.css">
</head>

<body>

  <header class="navbar">
    <div class="container nav-inner">
      <a href="/" class="logo">
        <div class="logo-icon">+</div>
        <div class="logo-text"><strong>GBC</strong><small>Farmacia</small></div>
      </a>
      {{> nav activeInicio=true}}
     <div class="nav-actions">

  {{#if loggedIn}}
  <div class="user-menu">
    <button class="user-btn" onclick="toggleUserMenu()" id="user-menu-btn">
      <span class="user-avatar">{{usuario.nombre.[0]}}</span>
      <span class="user-name">{{usuario.nombre}}</span>
    </button>

    <div class="user-dropdown" id="user-dropdown">
      <div class="dropdown-header">
        <strong>{{usuario.nombre}}</strong>
        <small>{{usuario.correo}}</small>
      </div>

      <div class="dropdown-divider"></div>

      <a href="/logout" class="dropdown-item">
        🚪 Cerrar sesión
      </a>
    </div>
  </div>
  {{else}}
  <a href="/login" class="btn btn-hero btn-sm" id="cta-login">
    Iniciar sesión
  </a>
  {{/if}}

  <!-- carrito -->
  <button class="cart-btn" onclick="openDrawer()" aria-label="Abrir carrito">
    🛒<span class="cart-badge"></span>
  </button>

  <button class="menu-btn" onclick="toggleMenu()" aria-label="Menú">
    ☰
  </button>

</div>
    </div>
    <div class="mobile-menu" id="mobile-menu">
      <div class="container">
        {{> nav-mobile}}
        {{#if loggedIn}}
        <a href="/logout" class="btn btn-outline">🚪 Cerrar sesión</a>
        {{else}}
        <a href="/login" class="btn btn-hero">Iniciar sesión</a>
        {{/if}}
      </div>
    </div>
  </header>

  <main>

    <section id="inicio" class="hero">
      <div class="container hero-grid">
        <div class="fade-up">
          <span class="tag tag-accent"><span class="dot"></span> Abierto 24/7</span>
          <h1>Tu salud,<br />nuestra <span class="text-accent">prioridad</span>.</h1>
          <p class="lead">En Farmacia GBC encontrarás los mejores medicamentos, productos de cuidado personal y atención
            profesional cerca de ti.</p>
          <div class="hero-cta">
            <a href="#ofertas" class="btn btn-hero btn-lg">Ver Ofertas</a>
            <a href="/sucursales" class="btn btn-outline btn-lg">Encuentra una sucursal</a>
          </div>
          <div class="hero-features">
            <div class="f">
              <div class="icon-box">🚚</div><span>Envío rápido</span>
            </div>
            <div class="f">
              <div class="icon-box">🛡️</div><span>100% original</span>
            </div>
            <div class="f">
              <div class="icon-box">⏰</div><span>Atención 24h</span>
            </div>
          </div>
        </div>
        <div class="hero-img-wrap">
          <div class="bg-tilt"></div>
          <div class="hero-img">💊</div>
          <div class="hero-badge">
            <div class="circle">🛡️</div>
            <div><strong>+25</strong><small>años cuidándote</small></div>
          </div>
        </div>
      </div>
    </section>

    <section id="ofertas">
      <div class="container">
        <div class="section-head">
          <span class="tag tag-accent">🏷️ Ofertas de la semana</span>
          <h2>Promociones imperdibles</h2>
          <p>Ahorra en tus productos favoritos con descuentos especiales solo en GBC.</p>
        </div>
        <div class="grid grid-3" id="ofertas-grid">
          {{#each ofertas}}
          <article class="card">
            <div class="card-header">
              <span class="cat-pill muted">{{this.categoria}}</span>
              {{#if this.descuento}}
              <span class="discount-pill">{{this.descuento}}</span>
              {{/if}}
            </div>
            <div class="offer-img">
              <img src="{{this.imagen}}" alt="{{this.nombre}}" loading="lazy" width="320" height="320" onerror="this.onerror=null;this.src='/img/categorias/default.svg'">
            </div>
            <h3>{{this.nombre}}</h3>
            <p class="desc">{{this.descripcion}}</p>
            <div class="row">
              <div>
                <span class="price price-accent">${{this.precio}}</span>
                {{#if this.precio_anterior}}
                <span class="price-old">${{this.precio_anterior}}</span>
                {{/if}}
              </div>
              <button class="btn btn-primary btn-sm"
                data-id="{{this.id}}" data-name="{{this.nombre}}" data-price="{{this.precio}}" data-stock="{{this.stock}}"
                onclick="addToCartFromBtn(this)">Comprar</button>
            </div>
          </article>
          {{/each}}
        </div>
      </div>
    </section>


    <section id="categorias">
      <div class="container">
        <div class="section-head">
          <span class="tag tag-primary">🛍️ Nuestro catálogo</span>
          <h2>Categorías</h2>
          <p>Explora nuestra amplia variedad de productos farmacéuticos y de cuidado personal
            organizados por categorías.</p>
        </div>
        <div class="grid grid-3">
          <article class="card">
            <div class="icon-circle">💊</div>
            <h3>Medicamentos</h3>
            <p class="desc">Medicina general y de prescripción</p>
            <div class="row"><span class="cat-pill">+1200 PRODUCTOS</span><a href="/productos?categoria=Medicamentos"
                class="text-accent link-more">Ver más →</a></div>
          </article>
          <article class="card">
            <div class="icon-circle">❤️</div>
            <h3>Cuidado Cardiovascular</h3>
            <p class="desc">Para el cuidado de tu corazón</p>
            <div class="row"><span class="cat-pill">+150 PRODUCTOS</span><a href="/productos?categoria=Cardiovascular"
                class="text-accent link-more">Ver más →</a></div>
          </article>
          <article class="card">
            <div class="icon-circle">👶</div>
            <h3>Bebés y Niños</h3>
            <p class="desc">Productos especializados para los más pequeños</p>
            <div class="row"><span class="cat-pill">+300 PRODUCTOS</span><a href="/productos?categoria=Bebés"
                class="text-accent link-more">Ver más →</a></div>
          </article>
          <article class="card">
            <div class="icon-circle">✨</div>
            <h3>Dermocosmética</h3>
            <p class="desc">Cuidado facial y corporal</p>
            <div class="row"><span class="cat-pill">+450 PRODUCTOS</span><a href="/productos?categoria=Dermocosmética"
                class="text-accent link-more">Ver más →</a></div>
          </article>
          <article class="card">
            <div class="icon-circle">🧴</div>
            <h3>Cuidado Personal</h3>
            <p class="desc">Higiene y bienestar diario</p>
            <div class="row"><span class="cat-pill">+200 PRODUCTOS</span><a href="/productos?categoria=Cuidado+Personal"
                class="text-accent link-more">Ver más →</a></div>
          </article>
          <article class="card">
            <div class="icon-circle">🌿</div>
            <h3>Naturales y Vitaminas</h3>
            <p class="desc">Suplementos y productos naturales</p>
            <div class="row"><span class="cat-pill">+380 PRODUCTOS</span><a href="/productos?categoria=Vitaminas"
                class="text-accent link-more">Ver más →</a></div>
          </article>
        </div>
        <div class="center-action">
          <a href="/productos" class="btn btn-hero btn-lg">Ver catálogo completo →</a>
        </div>
      </div>
    </section>

    <section id="nosotros" class="section-soft">
      <div class="container">
        <div class="about-grid">
          <div>
            <span class="tag tag-accent">Sobre GBC</span>
            <h2 class="section-title-large">Más que una farmacia,<br /><span class="text-accent">somos tu aliado en
                salud</span>.</h2>
            <p class="section-subtitle-large">Desde 2000, Farmacia GBC ha estado al servicio de las familias mexicanas,
              ofreciendo medicamentos de calidad, asesoría profesional y un servicio cálido. Nuestra misión es hacer la
              salud accesible para todos.</p>
          </div>
          <div class="stats">
            <div class="stat">
              <p class="num">25+</p><small>Años de experiencia</small>
            </div>
            <div class="stat">
              <p class="num">50K+</p><small>Clientes felices</small>
            </div>
            <div class="stat">
              <p class="num">12</p><small>Sucursales activas</small>
            </div>
            <div class="stat">
              <p class="num">10K+</p><small>Productos disponibles</small>
            </div>
          </div>
        </div>
        <div class="values">
          <div class="value">
            <div class="icon-circle">❤️</div>
            <h3>Compromiso</h3>
            <p class="desc">Cuidamos tu salud como si fuera la nuestra.</p>
          </div>
          <div class="value">
            <div class="icon-circle">🏆</div>
            <h3>Calidad</h3>
            <p class="desc">Solo medicamentos certificados y de marcas confiables.</p>
          </div>
          <div class="value">
            <div class="icon-circle">👥</div>
            <h3>Cercanía</h3>
            <p class="desc">Atención personalizada por farmacéuticos expertos.</p>
          </div>
          <div class="value">
            <div class="icon-circle">✨</div>
            <h3>Innovación</h3>
            <p class="desc">Tecnología y servicio digital para tu comodidad.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="contacto" class="contact-section">
      <div class="container">
        <div class="contact-header">
          <span class="support-badge">SOPORTE</span>
          <h2 class="contact-title">¿Tienes dudas?</h2>
          <p class="contact-subtitle">Estamos siempre disponibles para ayudarte.</p>
        </div>

        <div class="contact-cards">
          <div class="contact-card">
            <div class="contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M2 5.5C2 4.11929 3.11929 3 4.5 3H19.5C20.8807 3 22 4.11929 22 5.5V18.5C22 19.8807 20.8807 21 19.5 21H4.5C3.11929 21 2 19.8807 2 18.5V5.5ZM4.5 5C4.22386 5 4 5.22386 4 5.5V6.78207L11.5833 11.8358C11.8341 12.003 12.1659 12.003 12.4167 11.8358L20 6.78207V5.5C20 5.22386 19.7761 5 19.5 5H4.5ZM20 9.18378L13.5222 13.502C12.6027 14.115 11.3973 14.115 10.4778 13.502L4 9.18378V18.5C4 18.7761 4.22386 19 4.5 19H19.5C19.7761 19 20 18.7761 20 18.5V9.18378Z"/>
              </svg>
            </div>
            <h3>Escríbenos</h3>
            <p>contacto@farmaciagbc.com</p>
          </div>
          <div class="contact-card">
            <div class="contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21.3843 17.5813C21.8475 19.0177 20.8524 20.4746 19.3499 20.8447C15.9328 21.6865 11.5828 20.5982 7.74797 16.7634C3.91316 12.9286 2.82483 8.57863 3.66668 5.16147C4.03673 3.65902 5.49367 2.66395 6.93005 3.12711L9.75487 4.03845C10.7412 4.35649 11.3506 5.37255 11.2007 6.40248C11.087 7.18322 11.2461 7.99042 11.6917 8.70588C12.4418 9.91032 13.626 11.0945 14.8305 11.8446C15.5459 12.2902 16.3531 12.4493 17.1339 12.3357C18.1638 12.1857 19.1799 12.7952 19.4979 13.7815L21.3843 17.5813Z"/>
              </svg>
            </div>
            <h3>Llámanos</h3>
            <p>(55) 1234-5678</p>
          </div>
          <div class="contact-card">
            <div class="contact-icon">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C7.58172 2 4 5.58172 4 10C4 14.1594 7.64333 19.4447 11.1963 23.3644C11.6214 23.8335 12.3786 23.8335 12.8037 23.3644C16.3567 19.4447 20 14.1594 20 10C20 5.58172 16.4183 2 12 2ZM12 13C10.3431 13 9 11.6569 9 10C9 8.34315 10.3431 7 12 7C13.6569 7 15 8.34315 15 10C15 11.6569 13.6569 13 12 13Z"/>
              </svg>
            </div>
            <h3>Oficinas centrales</h3>
            <p>Av. Juárez 245, CDMX</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  {{> footer}}

  <!-- CART DRAWER -->
  <div class="drawer-overlay" id="drawer-overlay" onclick="closeDrawer()"></div>
  <aside class="drawer" id="drawer" aria-label="Carrito">
    <div class="drawer-head">
      <h3>🛒 Tu carrito (<span id="drawer-count">0</span>)</h3>
      <button class="drawer-close" onclick="closeDrawer()" aria-label="Cerrar">✕</button>
    </div>
    <div class="drawer-body" id="drawer-body"></div>
    <div class="drawer-foot hidden" id="drawer-foot">
      <div class="total-row"><span>Total</span><span id="drawer-total">$0</span></div>
      <button class="btn btn-hero btn-block" onclick="checkout()">Confirmar pedido ➤</button>
      <button class="btn btn-outline btn-block mt-8" onclick="clearCart()">Vaciar carrito</button>
    </div>
  </aside>

  <!-- Toast notifications -->
  <div class="toast-container" id="toast-container"></div>

  <script src="/js/Inicio.js"></script>
</body>

</html>
